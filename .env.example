# Copy to .env, chmod 600 .env, then use uv run --env-file .env --locked.
# Deployment target: hostname/IP for ssh, or a root directory for chroot.
WDC_TARGET=
WDC_CONNECTION=ssh
WDC_SSH_USER=root
WDC_SSH_PORT=22
WDC_HOST_USER=csqua

# Restore an existing RustDesk identity during first installation.
# Leave false for a new identity. Enabling this requires the ID and key pair.
# JSON arrays/maps are quoted to preserve their syntax in dotenv.
WDC_RUSTDESK_RESTORE_IDENTITY=false
WDC_RUSTDESK_ENC_ID=
WDC_RUSTDESK_PASSWORD=
WDC_RUSTDESK_SALT=
WDC_RUSTDESK_KEY_PAIR='[[], []]'
WDC_RUSTDESK_KEY_CONFIRMED=false
WDC_RUSTDESK_KEYS_CONFIRMED='{}'
WDC_RUSTDESK_TRUSTED_DEVICES=
WDC_RUSTDESK_UNLOCK_PIN=
WDC_RUSTDESK_RENDEZVOUS_SERVER=
